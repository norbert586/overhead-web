# Required in production — change these before deploying
JWT_SECRET=replace-with-a-long-random-secret
INVITE_CODE=replace-with-your-invite-code

# Admin allowlist — comma-separated emails. Authoritative: every user not in
# this list is demoted to is_admin = 0 on each startup. Leave unset to skip
# the sync entirely (existing admin flags are preserved).
ADMIN_EMAILS=ratiunorbert@gmail.com

# Optional
PORT=3001

# Optional — override the primary ADS-B endpoint (e.g. a local mock for
# testing). Requests go to <base>/<lat>/<lon>/<radius_nm> and the endpoint must
# return ALL aircraft in that circle. Default: https://api.adsb.lol/v2/point
# (Not /v2/closest — that returns only the single nearest aircraft.)
# ADSB_BASE_URL=

# Logging — pino. One of: trace, debug, info, warn, error, fatal, silent.
# Defaults to debug in dev, info in production.
LOG_LEVEL=debug
# Set NODE_ENV=production to switch to JSON output (otherwise pretty-printed).
# NODE_ENV=production

# ── Email ────────────────────────────────────────────────────────────────────
# Required for welcome / password-reset / email-verification emails to send.
# Without any of these, those flows are no-ops (logged but not delivered).
#
# Preferred: Resend (https://resend.com). Free tier covers low-volume use.
#   1. Verify the sending domain in the Resend dashboard.
#   2. Create an API key and paste it below.
#   3. Set EMAIL_FROM to an address on the verified domain.
RESEND_API_KEY=
EMAIL_FROM=Overhead <noreply@overheadflight.com>

# Fallback: plain SMTP (used only if RESEND_API_KEY is unset).
# Works with Gmail App Passwords, Postmark, SES, Mailgun, etc.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Public URL used to build email links (password reset, verification, etc.).
# In production set this to the canonical site URL.
APP_URL=http://localhost:5174
